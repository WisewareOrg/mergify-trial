{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>WisewareOrg/wise-renovate#v1.6.0"
  ],
  "platformAutomerge": false,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance"
      ],
      "automerge": false,
      "addLabels": [
        "automerge"
      ]
    }
  ],
  "rebaseWhen": "conflicted",
  "prCreation": "immediate",
  "internalChecksFilter": "strict"
}
